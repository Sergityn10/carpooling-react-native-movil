{
  "expo": {
    "name": "YouConnextApp",
    "slug": "YouConnextApp",
    "version": "1.0.21",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/logo-con-bg-ajustado.png",
    "userInterfaceStyle": "light",
    "scheme": "youconnext",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:app.youconnext.es"
      ]
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "app.youconnext",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.youconnext.es",
              "pathPrefix": "/redirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo-sin-bg-198px-ajustado.png"
    },
    "extra": {
      "eas": {
        "projectId": "55af1ecc-6702-43e8-a1bd-b1f93698054c"
      }
    },
    "plugins": [
      "./plugins/withGoogleServicesFile",
      "./plugins/withAndroidSigning",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite a YouConnext acceder a tu ubicación mientras usas la app para encontrar viajes y eventos cercanos.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyA-gBebs-tVR09fSgHcn5YeMQ-MnlPw1NM"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-sin-bg-198px-ajustado.png",
          "color": "#4A90D9"
        }
      ],
      "expo-secure-store"
    ]
  }
}
