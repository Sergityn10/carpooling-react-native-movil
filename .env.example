# YouConnext — Environment Variables (example)
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# API URLs
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_TRAYECTOS_API_URL=http://localhost:4001
EXPO_PUBLIC_MESSAGES_API_URL=http://localhost:4002
EXPO_PUBLIC_NOTIFICATIONS_API_URL=http://localhost:3004
EXPO_PUBLIC_TRACKING_API_URL=http://localhost:4003

# Google
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
EXPO_GOOGLE_OAUTH=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Pricing
EXPO_PUBLIC_RECOMMENDED_PRICE_PER_KM=0.06
EXPO_PUBLIC_MIN_PRICE_PER_KM=0.06
EXPO_PUBLIC_MAX_PRICE_PER_KM=0.08
